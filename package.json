{
  "name": "walka-walka",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "A new app created with @inglorious/create-app",
  "author": "",
  "license": "MIT",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint .",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "changeset": "changeset",
    "release:version": "changeset version",
    "cap": "cap",
    "mobile:init:ios": "cap add ios && inglorious-capacitor assets --ios",
    "mobile:init:android": "cap add android && inglorious-capacitor assets --android",
    "mobile:assets": "inglorious-capacitor assets",
    "mobile:listing-assets": "inglorious-capacitor listing-assets",
    "capacitor:sync:after": "inglorious-capacitor configure",
    "mobile:sync": "pnpm build && cap sync",
    "mobile:ios": "pnpm build && cap run ios",
    "mobile:android": "pnpm build && cap run android",
    "mobile:dev:ios": "inglorious-capacitor dev ios",
    "mobile:dev:android": "inglorious-capacitor dev android",
    "build:release": "inglorious-live-update build",
    "mobile:release": "inglorious-capacitor version && pnpm build:release && cap sync",
    "secrets:push": "inglorious-supabase secrets",
    "vault:push": "inglorious-supabase vault",
    "edge": "supabase functions serve",
    "edge:check": "cd supabase/functions && deno check */index.ts && deno lint",
    "live:keys": "inglorious-live-update keys",
    "live:release": "inglorious-live-update release",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit"
  },
  "dependencies": {
    "@capacitor-firebase/analytics": "^8.5.2",
    "@capacitor-firebase/messaging": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capawesome/capacitor-live-update": "^8.8.1",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/titillium-web": "^5.3.0",
    "@iconify-icons/fa7-brands": "^2.0.0",
    "@iconify-icons/fa7-regular": "^2.0.0",
    "@iconify-icons/fa7-solid": "^2.0.0",
    "@inglorious/firebase": "^0.2.0",
    "@inglorious/i18n": "^2.1.0",
    "@inglorious/store": "^12.9.0",
    "@inglorious/supabase": "^0.13.2",
    "@inglorious/ui": "^9.20.3",
    "@inglorious/web": "^6.31.0",
    "@supabase/supabase-js": "^2.118.0",
    "firebase": "^12.19.0"
  },
  "devDependencies": {
    "@inglorious/eslint-config": "^1.2.0",
    "@inglorious/vite-plugin-hmr": "^1.1.0",
    "@types/node": "^26.4.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.13.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "rollup-plugin-minify-template-literals": "^2.2.0",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.4",
    "vite-plugin-image-optimizer": "^2.0.3",
    "@changesets/cli": "^3.0.3",
    "vite-plugin-pwa": "^2.0.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "workbox-window": "^7.4.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@inglorious/capacitor": "^0.5.1",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">= 26"
  },
  "native": {
    "appLinks": {
      "domain": "",
      "exclude": [
        "#*access_token*"
      ]
    },
    "ios": {
      "teamId": "",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "swipeBack": true
    },
    "android": {
      "sha256": [],
      "permissions": []
    },
    "assets": {
      "background": "#ffffff",
      "backgroundDark": "#121212"
    }
  },
  "liveUpdate": {
    "minBuild": 1
  }
}
